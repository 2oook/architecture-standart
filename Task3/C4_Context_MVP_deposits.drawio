<mxfile host="drawio" version="24.8.4"><diagram id="C4 Context — MVP онлайн-депозитов" name="C4 Context — MVP онлайн-депозитов"><mxGraphModel adaptiveColors="none" dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;span style=&quot;font-size:22px;&quot;&gt;C4. Диаграмма контекста: MVP подачи заявок на депозит на сайте и в интернет-банке&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555;&quot;&gt;Банк «Стандарт», целевое состояние через 6 месяцев&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="16.0" width="1900.0" height="60.0" as="geometry"/></mxCell><mxCell id="pot_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="157.0" y="112.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="pot" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Потенциальный клиент&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новый клиент банка, посетитель сайта&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="160.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="cli_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="567.0" y="112.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="cli" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Клиент банка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Пользователь интернет-банка&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="470.0" y="160.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="op_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="977.0" y="112.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="op" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Оператор кол-центра&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Обрабатывает заявки с сайта&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="880.0" y="160.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="dep_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1397.0" y="112.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="dep" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Менеджер бэк-офиса&lt;br&gt;депозитов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Обрабатывает заявки, подтверждает&lt;br&gt;ставку&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1290.0" y="160.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="cred_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1767.0" y="112.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="cred" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Сотрудник бэк-офиса кредитов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Ведёт параметры риска для ставок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1660.0" y="160.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="site" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Сайт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[PHP, React.js]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Показывает депозиты и ставки, принимает&lt;br&gt;заявку от нового клиента&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="420.0" width="280.0" height="150.0" as="geometry"/></mxCell><mxCell id="ib" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Интернет-банк&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[ASP.NET MVC 4.5 + новые микросервисы&lt;br&gt;.NET 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Ставки, персональные ставки, заявка на&lt;br&gt;депозит, СМС-код, статус заявки&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="450.0" y="420.0" width="280.0" height="150.0" as="geometry"/></mxCell><mxCell id="cc" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Система кол-центра&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Платформа подрядчика, Java Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Получает заявки с сайта, создаёт задачи на&lt;br&gt;звонок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="860.0" y="420.0" width="280.0" height="150.0" as="geometry"/></mxCell><mxCell id="abs" value="&lt;span style=&quot;font-size:14px;&quot;&gt;АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Delphi, Oracle PL/SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Ведёт ставки и персональные предложения, хранит онлайн-заявки,&lt;br&gt;открывает депозиты&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1350.0" y="420.0" width="420.0" height="150.0" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Интеграционная платформа&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Apache Kafka]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Асинхронный обмен событиями: ставки, заявки, статусы, лиды, СМС. Защищает АБС от нагрузки онлайн-каналов&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="450.0" y="730.0" width="820.0" height="120.0" as="geometry"/></mxCell><mxCell id="sms" value="&lt;span style=&quot;font-size:14px;&quot;&gt;СМС-шлюз&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[сопровождает IT-отдел банка]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Отправляет СМС через телеком-оператора&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="730.0" width="280.0" height="120.0" as="geometry"/></mxCell><mxCell id="tel" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Телеком-оператор&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[внешняя система]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Доставляет СМС клиенту&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="960.0" width="280.0" height="110.0" as="geometry"/></mxCell><mxCell id="b16" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Примечания&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Новый клиент после звонка оператора приходит в отделение для идентификации (вне&lt;br&gt;MVP-изменений).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Интернет-банк сохраняет существующую интеграцию с БД АБС для платежей и счетов. В новом&lt;br&gt;процессе прямых вызовов АБС нет.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontColor=#222222;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1350.0" y="960.0" width="600.0" height="120.0" as="geometry"/></mxCell><mxCell id="t17" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Легенда&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="450.0" y="1120.0" width="200.0" height="22.0" as="geometry"/></mxCell><mxCell id="b18" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Пользователь&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="450.0" y="1146.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b19" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Новый элемент&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="612.0" y="1146.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b20" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Дорабатывается&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="1146.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b21" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Без изменений&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="936.0" y="1146.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b22" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Внешняя система&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1098.0" y="1146.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="t24" value="&lt;span style=&quot;font-size:11px;&quot;&gt;синхронный вызов / поток данных&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1338.0" y="1154.0" width="220.0" height="20.0" as="geometry"/></mxCell><mxCell id="t26" value="&lt;span style=&quot;font-size:11px;&quot;&gt;существующая интеграция / вне MVP&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1338.0" y="1174.0" width="240.0" height="20.0" as="geometry"/></mxCell><mxCell id="ed2" value="Смотрит ставки, оставляет&lt;br&gt;ФИО и телефон [HTTPS]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="pot" target="site"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed3" value="Смотрит ставки, подаёт&lt;br&gt;заявку, вводит СМС-код&lt;br&gt;[HTTPS]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cli" target="ib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed4" value="Видит заявку, звонит&lt;br&gt;клиенту" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="op" target="cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed5" value="Звонит, рассказывает об условиях [телефон]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;dashed=1;dashPattern=6 4;exitX=0.5000;exitY=-0.4800;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=-0.4800;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="op" target="pot"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000.0" y="95.0"/><mxPoint x="180.0" y="95.0"/></Array></mxGeometry></mxCell><mxCell id="ed6" value="Подтверждает ставку,&lt;br&gt;открывает депозит" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1667;entryY=0.0000;entryDx=0;entryDy=0;en