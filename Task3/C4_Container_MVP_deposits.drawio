<mxfile host="drawio" version="24.8.4"><diagram id="C4 Container — MVP онлайн-депозитов" name="C4 Container — MVP онлайн-депозитов"><mxGraphModel adaptiveColors="none" dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;span style=&quot;font-size:22px;&quot;&gt;C4. Диаграмма контейнеров: MVP подачи заявок на депозит (интернет-банк и АБС детализированы)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555;&quot;&gt;Банк «Стандарт», целевое состояние через 6 месяцев&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="16.0" width="2600.0" height="60.0" as="geometry"/></mxCell><mxCell id="pot_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="137.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="pot" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Потенциальный клиент&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Посетитель сайта&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="150.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="cli_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="697.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="cli" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Клиент банка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Пользователь интернет-банка&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="600.0" y="150.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="dep_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1757.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="dep" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Менеджер бэк-офиса&lt;br&gt;депозитов&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1660.0" y="150.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="cred_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2057.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="cred" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Сотрудник бэк-офиса&lt;br&gt;кредитов&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1960.0" y="150.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="op_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2507.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="op" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Оператор кол-центра&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2400.0" y="150.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="site" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Сайт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[PHP, React.js]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Витрина депозитов и форма заявки&lt;br&gt;(ФИО, телефон, согласие на обработку&lt;br&gt;ПДн, CAPTCHA)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="330.0" width="240.0" height="140.0" as="geometry"/></mxCell><mxCell id="bd2" value="&lt;span style=&quot;font-size:14px;color:#0B4884;&quot;&gt;Интернет-банк&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#0B4884;&quot;&gt;[Система] монолит + новые микросервисы депозитов (Kubernetes, 2 ЦОД)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0B4884;fontColor=#0B4884;fontSize=12;align=left;verticalAlign=top;spacing=10;spacingTop=0;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="320.0" y="270.0" width="1140.0" height="820.0" as="geometry"/></mxCell><mxCell id="ibdb" value="&lt;span style=&quot;font-size:13px;&quot;&gt;БД ИБ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[MS SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Данные монолита&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="350.0" y="340.0" width="180.0" height="120.0" as="geometry"/></mxCell><mxCell id="mono" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Веб-приложение ИБ (монолит)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[ASP.NET MVC 4.5, .NET Framework 4.5]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новый раздел «Депозиты»: экраны по дизайн-системе,&lt;br&gt;серверные вызовы сервисов депозитов (BFF)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="590.0" y="320.0" width="320.0" height="150.0" as="geometry"/></mxCell><mxCell id="gw" value="&lt;span style=&quot;font-size:14px;&quot;&gt;API Gateway&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[YARP, .NET 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Единая точка входа: маршрутизация, mTLS, ограничение частоты запросов, балансировка между экземплярами и ЦОД&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="550.0" width="1060.0" height="90.0" as="geometry"/></mxCell><mxCell id="notif" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Сервис уведомлений&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[.NET 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Шаблоны СМС, отправка через&lt;br&gt;СМС-шлюз, повторы, журнал&lt;br&gt;доставки&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="730.0" width="220.0" height="160.0" as="geometry"/></mxCell><mxCell id="otp" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Сервис подтверждения&lt;br&gt;(OTP)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[.NET 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Генерация и проверка СМС-кода:&lt;br&gt;TTL 5 мин, лимит попыток&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="640.0" y="730.0" width="220.0" height="160.0" as="geometry"/></mxCell><mxCell id="app" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Сервис заявок на депозит&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[.NET 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Заявки из ИБ и лиды с сайта, статусы,&lt;br&gt;идемпотентность, Transactional Outbox&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="940.0" y="730.0" width="240.0" height="160.0" as="geometry"/></mxCell><mxCell id="rates" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Сервис ставок и продуктов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[.NET 8]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Каталог продуктов, общие и&lt;br&gt;персональные ставки, кеш в&lt;br&gt;памяти&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1220.0" y="730.0" width="220.0" height="160.0" as="geometry"/></mxCell><mxCell id="notifdb" value="&lt;span style=&quot;font-size:12px;&quot;&gt;БД уведомлений&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[MS SQL]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="360.0" y="950.0" width="140.0" height="110.0" as="geometry"/></mxCell><mxCell id="otpdb" value="&lt;span style=&quot;font-size:12px;&quot;&gt;БД OTP&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[MS SQL]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="640.0" y="950.0" width="140.0" height="110.0" as="geometry"/></mxCell><mxCell id="appdb" value="&lt;span style=&quot;font-size:12px;&quot;&gt;БД заявок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[MS SQL]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="940.0" y="950.0" width="140.0" height="110.0" as="geometry"/></mxCell><mxCell id="ratesdb" value="&lt;span style=&quot;font-size:12px;&quot;&gt;БД ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[MS SQL]&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1220.0" y="950.0" width="140.0" height="110.0" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Брокер сообщений&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Apache Kafka: кластер в двух ЦОД, TLS + SASL, Schema Registry]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Топики: deposit.rates.published, deposit.offers.published, deposit.application.submitted, deposit.application.status-changed, deposit.lead.created, notification.sms.requested&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="320.0" y="1180.0" width="1960.0" height="150.0" as="geometry"/></mxCell><mxCell id="sms" value="&lt;span style=&quot;font-size:13px;&quot;&gt;СМС-шлюз&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[сопровождает IT-отдел банка]&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1180.0" width="240.0" height="110.0" as="geometry"/></mxCell><mxCell id="tel" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Телеком-оператор&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[внешняя система]&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1420.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="bd3" value="&lt;span style=&quot;font-size:14px;color:#0B4884;&quot;&gt;АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#0B4884;&quot;&gt;[Система]&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0B4884;fontColor=#0B4884;fontSize=12;align=left;verticalAlign=top;spacing=10;spacingTop=0;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1560.0" y="270.0" width="720.0" height="820.0" as="geometry"/></mxCell><mxCell id="absui" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Десктоп-клиент АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Delphi]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новые формы: «Ставки» (ролевой доступ депозиты / кредиты), «Онлайн-заявки», «Согласование спецставки»&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1600.0" y="330.0" width="640.0" height="140.0" as="geometry"/></mxCell><mxCell id="absdb" value="&lt;span style=&quot;font-size:14px;&quot;&gt;БД АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Oracle, PL/SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новые пакеты: модуль ставок и персональных предложений, модуль онлайн-заявок, PL/SQL API&lt;br&gt;приёма заявок, таблицы Inbox / Outbox&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1640.0" y="560.0" width="560.0" height="200.0" as="geometry"/></mxCell><mxCell id="adapter" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Интеграционный адаптер АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Java 17, Spring Boot, Spring Kafka]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Публикует события из Outbox (ставки, предложения, статусы). Принимает заявки и передаёт в&lt;br&gt;PL/SQL API с ограничением скорости&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1640.0" y="880.0" width="560.0" height="150.0" as="geometry"/></mxCell><mxCell id="cc" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Система кол-центра&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Платформа подрядчика: React.js, Java Spring Boot,&lt;br&gt;PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новый модуль: приём лидов с сайта из Kafka, задачи&lt;br&gt;на звонок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2360.0" y="560.0" width="320.0" height="180.0" as="geometry"/></mxCell><mxCell id="b32" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Примечания к развёртыванию&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Новые сервисы работают в Kubernetes в двух ЦОД (active-active). Базы MS SQL реплицируются через Always On.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Монолит ИБ разворачивается в двух ЦОД за балансировщиком. Сессии хранятся в MS SQL.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Интернет-банк и сайт не вызывают АБС в новом процессе. Обмен с АБС идёт только через Kafka и адаптер.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Персональные ставки рассчитывает АБС и публикует их заранее. Сервис ставок отвечает из кеша за миллисекунды.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontColor=#222222;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1620.0" y="1400.0" width="1060.0" height="110.0" as="geometry"/></mxCell><mxCell id="t33" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Легенда&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="320.0" y="1590.0" width="200.0" height="22.0" as="geometry"/></mxCell><mxCell id="b34" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Пользователь&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="320.0" y="1616.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b35" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Новый элемент&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="482.0" y="1616.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b36" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Дорабатывается&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="644.0" y="1616.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b37" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Без изменений&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="806.0" y="1616.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b38" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Внешняя система&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="968.0" y="1616.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="t40" value="&lt;span style=&quot;font-size:11px;&quot;&gt;синхронный вызов / поток данных&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1208.0" y="1624.0" width="220.0" height="20.0" as="geometry"/></mxCell><mxCell id="t42" value="&lt;span style=&quot;font-size:11px;&quot;&gt;существующая интеграция / вне MVP&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1208.0" y="1644.0" width="240.0" height="20.0" as="geometry"/></mxCell><mxCell id="ed4" value="Смотрит ставки, оставляет&lt;br&gt;ФИО и телефон [HTTPS]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="pot" target="site"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed5" value="Раздел «Депозиты»: ставки, заявка,&lt;br&gt;СМС-код, статус [HTTPS]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4062;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cli" target="mono"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed6" value="[SQL]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.0000;exitY=0.5333;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="mono" target="ibdb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed7" value="Вызовы сервисов депозитов&lt;br&gt;[HTTPS / REST, mTLS]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3679;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="mono" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCel