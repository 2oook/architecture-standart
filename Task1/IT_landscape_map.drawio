<mxfile host="drawio" version="24.8.4"><diagram id="Карта IT-ландшафта" name="Карта IT-ландшафта"><mxGraphModel adaptiveColors="none" dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1466" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;span style=&quot;font-size:22px;&quot;&gt;Банк «Стандарт»: карта текущего IT-ландшафта (AS-IS)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555;&quot;&gt;Строки — элементы организационной структуры, колонки — бизнес-возможности второго уровня. В ячейке — системы и ручные инструменты, которые подразделение использует для бизнес-возможности.&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="20.0" width="1920.0" height="50.0" as="geometry"/></mxCell><mxCell id="b2" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Организационная структура&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;fontColor=#333333;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="80.0" width="300.0" height="114.0" as="geometry"/></mxCell><mxCell id="b3" value="&lt;span style=&quot;font-size:16px;&quot;&gt;Продажи и маркетинг&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E5BC6;strokeColor=#1E5BC6;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="330.0" y="80.0" width="810.0" height="54.0" as="geometry"/></mxCell><mxCell id="b4" value="&lt;span style=&quot;font-size:16px;&quot;&gt;Поддержка операционных процессов&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E5BC6;strokeColor=#1E5B