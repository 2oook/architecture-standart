<mxfile host="drawio" version="24.8.4"><diagram id="C4 Component — ставки для кол-центров" name="C4 Component — ставки для кол-центров"><mxGraphModel adaptiveColors="none" dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2440" pageHeight="1640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;span style=&quot;font-size:22px;&quot;&gt;C4. Диаграмма компонентов: модуль ставок в системе кол-центра и сервис файлового обмена с партнёром&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555;&quot;&gt;Изменения к MVP. Показаны только элементы, которые важны для этого кейса&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="16.0" width="2380.0" height="60.0" as="geometry"/></mxCell><mxCell id="abs" value="&lt;span style=&quot;font-size:13px;&quot;&gt;БД АБС: модуль ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Oracle, PL/SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Утверждённые ставки и условия продуктов,&lt;br&gt;Outbox&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="150.0" width="280.0" height="130.0" as="geometry"/></mxCell><mxCell id="adapter" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Интеграционный адаптер АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Java 17, Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Публикует событие при утверждении ставок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="340.0" width="280.0" height="130.0" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Брокер сообщений&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Apache Kafka]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Топик deposit.rates.published: снимок всех&lt;br&gt;ставок, версия, дата действия&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="540.0" width="280.0" height="160.0" as="geometry"/></mxCell><mxCell id="bd2" value="&lt;span style=&quot;font-size:14px;color:#0B4884;&quot;&gt;Система кол-центра банка: модуль «Ставки»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#0B4884;&quot;&gt;[Контейнер] Spring Boot-микросервис и React-виджет, механизм расширения платформы подрядчика&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0B4884;fontColor=#0B4884;fontSize=12;align=left;verticalAlign=top;spacing=10;spacingTop=0;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="420.0" y="120.0" width="1220.0" height="480.0" as="geometry"/></mxCell><mxCell id="ccapi" value="&lt;span style=&quot;font-size:13px;&quot;&gt;REST API ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Web]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;GET /rates: актуальные ставки, дата и&lt;br&gt;версия&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="760.0" y="190.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="ccui" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Виджет «Ставки по депозитам»&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[React.js]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Таблица ставок в рабочем месте&lt;br&gt;оператора, отметка об устаревании&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1100.0" y="190.0" width="260.0" height="130.0" as="geometry"/></mxCell><mxCell id="cclist" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Kafka-слушатель ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Kafka]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Читает события, проверяет схему и&lt;br&gt;версию&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="420.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="ccsvc" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Сервис ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Сохраняет новую версию, хранит&lt;br&gt;историю, проверяет актуальность&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="760.0" y="420.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="ccrepo" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Репозиторий ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Data JPA]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Чтение и запись версий ставок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1060.0" y="420.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="ccdb" value="&lt;span style=&quot;font-size:13px;&quot;&gt;БД системы КЦ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новая схема rates&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1380.0" y="410.0" width="220.0" height="150.0" as="geometry"/></mxCell><mxCell id="op_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1887.0" y="152.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="op" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Оператор кол-центра банка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Консультирует клиента&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1780.0" y="200.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="bd3" value="&lt;span style=&quot;font-size:14px;color:#0B4884;&quot;&gt;Интеграционная платформа: сервис файлового обмена ставками&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#0B4884;&quot;&gt;[Контейнер] Java 17, Spring Boot. Kubernetes, 2 ЦОД, активен один экземпляр (ShedLock)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0B4884;fontColor=#0B4884;fontSize=12;align=left;verticalAlign=top;spacing=10;spacingTop=0;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="420.0" y="690.0" width="1220.0" height="600.0" as="geometry"/></mxCell><mxCell id="flist" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Kafka-слушатель ставок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Kafka]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Отбирает только публичные ставки,&lt;br&gt;сохраняет снимок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="780.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="frepo" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Репозиторий снимков и&lt;br&gt;журнала&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Data JPA]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Снимки ставок, журнал выгрузок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="760.0" y="780.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="fdb" value="&lt;span style=&quot;font-size:13px;&quot;&gt;БД выгрузок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[MS SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Снимки, журнал, статусы&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1080.0" y="770.0" width="200.0" height="150.0" as="geometry"/></mxCell><mxCell id="fsched" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Планировщик выгрузок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Scheduler, ShedLock]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Ежедневно в 07:30 МСК и через 5 мин&lt;br&gt;после нового снимка&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="970.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="fbuild" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Формирователь файла&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Java, Apache Commons CSV]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;CSV UTF-8 по согласованной схеме,&lt;br&gt;SHA-256, manifest&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="760.0" y="970.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="fpub" value="&lt;span style=&quot;font-size:13px;&quot;&gt;SFTP-публикатор&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Integration SFTP]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Атомарная загрузка: .tmp →&lt;br&gt;переименование&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1060.0" y="970.0" width="240.0" height="130.0" as="geometry"/></mxCell><mxCell id="fadmin" value="&lt;span style=&quot;font-size:13px;&quot;&gt;API администрирования&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Web]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Статус выгрузок, ручной перезапуск&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="460.0" y="1140.0" width="240.0" height="120.0" as="geometry"/></mxCell><mxCell id="fmon" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Монитор доставки&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Spring Boot]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Сверяет журнал выгрузок с SFTP,&lt;br&gt;шлёт алерты&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1060.0" y="1140.0" width="240.0" height="120.0" as="geometry"/></mxCell><mxCell id="sftp" value="&lt;span style=&quot;font-size:13px;&quot;&gt;SFTP-сервер&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[OpenSSH, DMZ банка]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Каталог партнёра: доступ по ключу и списку&lt;br&gt;IP, хранение 30 дней&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1780.0" y="970.0" width="280.0" height="130.0" as="geometry"/></mxCell><mxCell id="pcc" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Система партнёрского КЦ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Внешняя система]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Забирает файл по расписанию&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1780.0" y="1330.0" width="280.0" height="120.0" as="geometry"/></mxCell><mxCell id="pop_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2237.0" y="1292.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="pop" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Оператор партнёрского КЦ&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="2140.0" y="1340.0" width="240.0" height="100.0" as="geometry"/></mxCell><mxCell id="mon" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Система мониторинга IT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Prometheus, Grafana, Alertmanager]&lt;/span&g