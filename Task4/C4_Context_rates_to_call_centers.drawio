<mxfile host="drawio" version="24.8.4"><diagram id="C4 Context — ставки для кол-центров" name="C4 Context — ставки для кол-центров"><mxGraphModel adaptiveColors="none" dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;span style=&quot;font-size:22px;&quot;&gt;C4. Диаграмма контекста: передача актуальных ставок в кол-центр банка и партнёрский кол-центр&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555;&quot;&gt;Изменения к MVP. Показаны только элементы, которые важны для этого кейса&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30.0" y="16.0" width="1900.0" height="60.0" as="geometry"/></mxCell><mxCell id="cred_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="142.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="cred" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Сотрудник бэк-офиса&lt;br&gt;кредитов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Вводит ставку ЦБ и уровень риска&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="150.0" width="250.0" height="100.0" as="geometry"/></mxCell><mxCell id="dep_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="442.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="dep" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Менеджер бэк-офиса&lt;br&gt;депозитов&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Утверждает и публикует ставки&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="340.0" y="150.0" width="250.0" height="100.0" as="geometry"/></mxCell><mxCell id="op_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1287.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="op" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Оператор кол-центра банка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Консультирует клиентов по ставкам&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1180.0" y="150.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="cli_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1767.0" y="102.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="cli" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Клиент&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Звонит, чтобы уточнить условия депозита&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1660.0" y="150.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="pop_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1767.0" y="712.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="pop" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Оператор партнёрского КЦ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Консультирует клиентов при перегрузке&lt;br&gt;КЦ банка&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1660.0" y="760.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="sup_head" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#000;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="727.0" y="852.0" width="46.0" height="46.0" as="geometry"/></mxCell><mxCell id="sup" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Сотрудник сопровождения IT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Контролирует выгрузку ставок&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="620.0" y="900.0" width="260.0" height="100.0" as="geometry"/></mxCell><mxCell id="abs" value="&lt;span style=&quot;font-size:14px;&quot;&gt;АБС&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Delphi, Oracle PL/SQL]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Модуль ставок из MVP: расчёт, утверждение и публикация&lt;br&gt;ставок. Добавляется признак «публичная ставка» и условия&lt;br&gt;продукта&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="420.0" width="380.0" height="150.0" as="geometry"/></mxCell><mxCell id="int" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Интеграционная платформа&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Kafka, адаптер АБС, сервис файлового обмена, SFTP-сервер]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Доставляет ставки в кол-центр по событию и формирует файл&lt;br&gt;ставок для партнёра&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="620.0" y="420.0" width="380.0" height="150.0" as="geometry"/></mxCell><mxCell id="cc" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Система кол-центра банка&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Платформа подрядчика, Java Spring Boot, React.js]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Новый модуль «Ставки»: хранит актуальные ставки и&lt;br&gt;показывает их оператору&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1180.0" y="420.0" width="320.0" height="150.0" as="geometry"/></mxCell><mxCell id="pcc" value="&lt;span style=&quot;font-size:14px;&quot;&gt;Система партнёрского КЦ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#FFFFFF;&quot;&gt;[Внешняя система партнёра]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;Загружает файл ставок и показывает их операторам&lt;br&gt;партнёра&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1180.0" y="740.0" width="320.0" height="140.0" as="geometry"/></mxCell><mxCell id="b12" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Примечания&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Ставки публикуются из единого источника — модуля ставок АБС из MVP. Excel и почта для ставок больше не используются.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Партнёр получает только публичные ставки и условия продуктов. Персональных данных клиентов в файле нет.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;• Сайт и интернет-банк тоже читают ставки из Kafka (см. задание 3). Здесь они не показаны, потому что не меняются.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontColor=#222222;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1180.0" y="920.0" width="760.0" height="120.0" as="geometry"/></mxCell><mxCell id="t13" value="&lt;span style=&quot;font-size:13px;&quot;&gt;Легенда&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="1080.0" width="200.0" height="22.0" as="geometry"/></mxCell><mxCell id="b14" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Пользователь&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40.0" y="1106.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b15" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Новый элемент&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#1B5E20;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="202.0" y="1106.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b16" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Дорабатывается&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="364.0" y="1106.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b17" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Без изменений&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#6B6B6B;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="526.0" y="1106.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="b18" value="&lt;span style=&quot;font-size:12px;&quot;&gt;Внешняя система&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#5A5A5A;strokeColor=#3F3F3F;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacing=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="688.0" y="1106.0" width="150.0" height="34.0" as="geometry"/></mxCell><mxCell id="t20" value="&lt;span style=&quot;font-size:11px;&quot;&gt;синхронный вызов / поток данных&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="928.0" y="1114.0" width="220.0" height="20.0" as="geometry"/></mxCell><mxCell id="t22" value="&lt;span style=&quot;font-size:11px;&quot;&gt;существующая интеграция / вне MVP&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacing=0;spacingTop=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="928.0" y="1134.0" width="240.0" height="20.0" as="geometry"/></mxCell><mxCell id="ed2" value="Вводит параметры для&lt;br&gt;расчёта ставок" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.4400;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2368;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cred" target="abs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed3" value="Утверждает ставки,&lt;br&gt;запускает публикацию" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.2000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8684;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dep" target="abs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed4" value="Утверждённые ставки&lt;br&gt;[Outbox → Kafka]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="abs" target="int"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed5" value="Ставки по событию&lt;br&gt;[Kafka]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="int" target="cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed6" value="Файл ставок CSV: партнёр&lt;br&gt;забирает его по SFTP" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.7370;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="int" target="pcc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900.0" y="810.0"/></Array></mxGeometry></mxCell><mxCell id="ed7" value="Алерты о сбоях выгрузки;&lt;br&gt;ручной перезапуск" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=block;startFill=1;startSize=8;exitX=0.2632;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3846;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="int" target="sup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed8" value="Смотрит ставки во время&lt;br&gt;звонка" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4062;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="op" target="cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed9" value="Смотрит ставки во&lt;br&gt;время звонка" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="pop" target="pcc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed10" value="Звонит [телефон]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cli" target="op"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed11" value="Звонит при перегрузке КЦ&lt;br&gt;банка [телефон]" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=block;endFill=1;endSize=8;startArrow=none;exitX=0.1538;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1538;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cli" target="pop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l19" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="1123.0" as="sourcePoint"/><mxPoint x="920.0" y="1123.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l21" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#555555;fontColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.3;endArrow=none;startArrow=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860.0" y="1143.0" as="sourcePoint"/><mxPoint x="920.0" y="1143.0" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
